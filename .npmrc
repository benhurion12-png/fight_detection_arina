# onnxruntime-node's default install step tries to download CUDA EP binaries
# on linux/x64, and that manifest has an upstream path bug that makes the
# download always fail (https://github.com/microsoft/onnxruntime/issues -
# install-metadata.js points at runtimes/win-x64 for the linux/x64 entry).
# This app only uses DirectML (Windows) or CPU, never CUDA, so skip it.
onnxruntime-node-install=skip
